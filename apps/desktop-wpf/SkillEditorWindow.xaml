<Window x:Class="NovelGm.Desktop.SkillEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Skill.EditorNew}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{DynamicResource Common.Cancel}" Width="80" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="{DynamicResource Common.Save}" Width="80" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
               Margin="0,8,0,0" Visibility="Collapsed"/>
    <StackPanel>
      <Label Content="{DynamicResource Skill.Name}"/>
      <TextBox x:Name="NameBox"/>
      <Label Content="{DynamicResource Skill.Description}" Margin="0,6,0,0"/>
      <TextBox x:Name="DescriptionBox"/>
      <Label Content="{DynamicResource Skill.Source}" Margin="0,6,0,0"/>
      <TextBox x:Name="SourceBox"/>
      <Label Content="{DynamicResource Skill.Scope}" Margin="0,6,0,0"/>
      <ComboBox x:Name="ScopeCombo" HorizontalAlignment="Left" Width="200">
        <ComboBoxItem Content="{DynamicResource Skill.ScopeBoth}" Tag="both"/>
        <ComboBoxItem Content="{DynamicResource Skill.ScopePlan}" Tag="plan"/>
        <ComboBoxItem Content="{DynamicResource Skill.ScopeGenerate}" Tag="generate"/>
      </ComboBox>
      <Label Content="{DynamicResource Skill.Scenes}" Margin="0,6,0,0"/>
      <WrapPanel x:Name="ScenesPanel" Margin="4,2,0,0"/>
      <TextBlock Text="{DynamicResource Skill.ScenesHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap" Margin="4,4,0,0"/>
      <Label Content="{DynamicResource Skill.Instructions}" Margin="0,6,0,0"/>
      <TextBox x:Name="InstructionsBox" Height="240" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
      <TextBlock Text="{DynamicResource Skill.InstructionsHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
