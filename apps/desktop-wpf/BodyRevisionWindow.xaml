<Window x:Class="NovelGm.Desktop.BodyRevisionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="980" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Background="{DynamicResource Desk.Shell}" Foreground="{DynamicResource Desk.Ink}"
 Closing="WindowClosing">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls/ProofDesk.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Desk.Line}" BorderThickness="0,0,0,1"><StackPanel>
   <TextBlock Text="{DynamicResource Ai.Revision.Title}" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="ChapterHeading" Foreground="{DynamicResource Desk.Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Desk.Line}" BorderThickness="0,1,0,0" Padding="16,10">
   <StackPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel HorizontalAlignment="Right">
    <Button x:Name="RetrySave" Content="{DynamicResource Ai.Revision.Save}" Style="{StaticResource Desk.Button}" Margin="4" Click="SaveClick"/>
    <Button x:Name="Generate" Content="{DynamicResource Ai.Revision.Generate}" Style="{StaticResource Desk.Button}" Margin="4" Click="GenerateClick"/>
    <Button x:Name="Apply" Content="{DynamicResource Ai.Revision.Apply}" Style="{StaticResource Desk.Primary}" Margin="4" Click="ApplyClick"/>
    <Button Content="{DynamicResource Common.Close}" Style="{StaticResource Desk.Button}" Margin="4" Click="CloseClick"/>
   </WrapPanel></StackPanel>
  </Border>
  <Grid x:Name="Columns" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition x:Name="InputColumn" Width="0.36*"/><ColumnDefinition x:Name="PreviewColumn" Width="0.64*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
    <StackPanel>
     <TextBlock Text="{DynamicResource Ai.Revision.Request}" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBox x:Name="Instruction" Style="{StaticResource Desk.TextBox}" MinHeight="170" MaxLength="12000" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="InputChanged" AutomationProperties.Name="{DynamicResource Ai.Revision.Request}"/>
     <Button x:Name="Import" Content="{DynamicResource Ai.Revision.Import}" Style="{StaticResource Desk.Button}" Margin="0,10,0,20" Click="ImportClick"/>
     <TextBlock Text="{DynamicResource Ai.Revision.Issues}" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <StackPanel x:Name="Issues"/>
     <TextBlock Text="{DynamicResource Ai.Revision.Manual}" Foreground="{DynamicResource Desk.Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,0,0">
    <StackPanel><TextBlock Text="{DynamicResource Ai.Revision.Preview}" FontWeight="SemiBold" Margin="0,0,0,10"/><StackPanel x:Name="Patches"/></StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
