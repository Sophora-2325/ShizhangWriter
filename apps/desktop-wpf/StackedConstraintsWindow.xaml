<Window x:Class="NovelGm.Desktop.StackedConstraintsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Stack.Title}" Width="1280" Height="800" MinWidth="900" MinHeight="560"
 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterOwner"
 PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
 <DockPanel Margin="20,16">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
    <Button x:Name="UndoButton" Content="{DynamicResource Stack.Undo}" Click="Undo_Click" Padding="10,6" Margin="0,0,6,0"/>
    <Button x:Name="RedoButton" Content="{DynamicResource Stack.Redo}" Click="Redo_Click" Padding="10,6" Margin="0,0,6,0"/>
    <Button Content="{DynamicResource Stack.ClearSelection}" Click="ClearSelection_Click" Padding="10,6" Margin="0,0,6,0"/>
    <Button x:Name="SaveButton" Content="{DynamicResource Common.Save}" Click="Save_Click" Padding="16,6"/>
   </StackPanel>
   <StackPanel Margin="0,0,16,0">
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource Stack.Subtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Close}" Click="Close_Click" Padding="16,6" Margin="12,0,0,0"/>
   <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="3*"/><ColumnDefinition x:Name="SplitColumn" Width="16"/><ColumnDefinition x:Name="OverviewColumn" Width="2*"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <StackPanel x:Name="DomainsPanel"/>
   </ScrollViewer>
   <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrushKey}"/>
   <DockPanel x:Name="OverviewPanel" Grid.Column="2">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,12">
     <TextBlock Text="{DynamicResource Stack.Overview}" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="{DynamicResource Stack.OverviewHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="8,12,8,4">
     <TextBlock x:Name="SelectionText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="OverviewHost" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch"/></ScrollViewer>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
