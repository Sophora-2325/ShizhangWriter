  <sys:String x:Key="Sens.Delete">削除</sys:String>
  <sys:String x:Key="Sens.Import">TXT を読み込む…</sys:String>
  <sys:String x:Key="Sens.Export">TXT を書き出す…</sys:String>
  <sys:String x:Key="Sens.EmptyHint">単語リストは空です。単語を追加するか TXT を読み込んでください（1 行 1 語、UTF-8）。</sys:String>
  <sys:String x:Key="Sens.WordCount">{0} 語</sys:String>
