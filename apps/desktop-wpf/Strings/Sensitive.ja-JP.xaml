  <sys:String x:Key="Sens.Dup">{0} はすでに登録されています</sys:String>
  <sys:String x:Key="Sens.Added">追加しました：{0}</sys:String>
  <sys:String x:Key="Sens.Deleted">単語を削除しました</sys:String>
  <sys:String x:Key="Sens.SaveFailed">単語リストの保存に失敗しました：{0}</sys:String>
  <sys:String x:Key="Sens.ImportTitle">単語リストを選択</sys:String>
