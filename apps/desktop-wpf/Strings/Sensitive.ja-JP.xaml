  <sys:String x:Key="Sens.ImportInvalid">読み込みに失敗しました：ファイルが有効な UTF-8 ではありません</sys:String>
  <sys:String x:Key="Sens.ImportFailed">読み込みに失敗しました：{0}</sys:String>
  <sys:String x:Key="Sens.ExportTitle">単語リストを書き出す</sys:String>
