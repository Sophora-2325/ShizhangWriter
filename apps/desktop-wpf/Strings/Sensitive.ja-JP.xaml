  <sys:String x:Key="Sens.Rescan">再検出</sys:String>
  <sys:String x:Key="Sens.Hint">ローカルの単語リストで検査し、一致位置を示すだけです。本文は自動で変更しません。</sys:String>
  <sys:String x:Key="Sens.Hits">{0} 件</sys:String>
  <sys:String x:Key="Sens.NoHit">敏感語は見つかりませんでした</sys:String>
  <sys:String x:Key="Sens.NoWordsScan">単語リストが空です。先に追加または読み込みをしてください</sys:String>
  <sys:String x:Key="Sens.NoChapter">検査できる現在の章の本文がありません</sys:String>
  <sys:String x:Key="Sens.ChapterTitle">第 {0} 章 {1}</sys:String>
  <sys:String x:Key="Sens.ChapterOnly">第 {0} 章</sys:String>
  <sys:String x:Key="Sens.Count">{0} 件</sys:String>
  <sys:String x:Key="Sens.LocateTip">本文のこの位置へ移動</sys:String>
</ResourceDictionary>
