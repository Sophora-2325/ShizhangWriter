<Window x:Class="NovelGm.Desktop.ChapterSummaryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Main.ChapterSummary}" Width="640" Height="480" MinWidth="320" MinHeight="260"
 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock x:Name="ChapterTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
   <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
  </StackPanel>
  <Button DockPanel.Dock="Bottom" Content="{DynamicResource Common.Close}" HorizontalAlignment="Right" MinWidth="80" Margin="0,12,0,0" IsCancel="True" Click="Close_Click"/>
  <TextBox x:Name="SummaryBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" Padding="0"
   AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
   FontSize="15" TextBlock.LineHeight="24" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
   AutomationProperties.Name="{DynamicResource Main.ChapterSummary}"/>
 </DockPanel>
</Window>
