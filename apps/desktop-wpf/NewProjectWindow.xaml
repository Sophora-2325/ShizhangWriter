<Window x:Class="NovelGm.Desktop.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Main.NewWork}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{DynamicResource Common.Cancel}" Width="80" Click="Cancel_Click"/>
      <Button Content="{DynamicResource Common.Create}" Width="80" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
    </StackPanel>
    <StackPanel>
      <Label Content="{DynamicResource New.TitleLabel}"/>
      <TextBox x:Name="TitleBox" Text="{DynamicResource New.DefaultTitle}" TextChanged="PathInput_Changed"/>
      <Label Content="{DynamicResource New.Location}"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Browse}" Width="72" Margin="6,0,0,0" Click="Browse_Click"/>
        <TextBox x:Name="ParentBox" TextChanged="PathInput_Changed"/>
      </DockPanel>
      <TextBlock x:Name="PathHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <Label Content="{DynamicResource New.Background}"/>
      <TextBox x:Name="BackgroundBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="{DynamicResource New.CharactersHint}"
                 Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Label Content="{DynamicResource New.Sample}"/>
      <TextBox x:Name="SampleBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
  </DockPanel>
</Window>
