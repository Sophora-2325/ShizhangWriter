<UserControl x:Class="NovelGm.Desktop.Controls.AiPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource Desk.Ink}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProofDesk.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="Desk.Label" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
  <Style x:Key="Desk.Note" TargetType="TextBlock" BasedOn="{StaticResource Desk.Label}"><Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <DockPanel Background="{DynamicResource Desk.Shell}">
  <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Desk.Line}" BorderThickness="0,0,0,1">
   <StackPanel><TextBlock Text="AI" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ChapterHeading" Foreground="{DynamicResource Desk.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  </Border>
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,10">
   <StackPanel x:Name="Actions">
    <Border x:Name="BusyBox" Visibility="Collapsed" Padding="0,6"><StackPanel><TextBlock x:Name="BusyText" TextWrapping="Wrap"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,6"/></StackPanel></Border>
    <TextBlock x:Name="ReadOnlyHint" Text="{DynamicResource Ai.ReadOnlyHint}" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Desk.Muted}" Margin="0,8"/>
    <TextBlock Text="{DynamicResource Ai.Flow.Prepare}" FontWeight="SemiBold" Margin="0,6,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="PlanButton" Style="{StaticResource Desk.Button}" Click="Plan_Click"><StackPanel><TextBlock Text="{DynamicResource Ai.Step.ShowPlan}" Style="{StaticResource Desk.Label}"/><TextBlock Text="{DynamicResource Ai.Flow.Content}" Style="{StaticResource Desk.Note}"/></StackPanel></Button>
     <Button x:Name="StackedConstraintsButton" Grid.Column="2" Style="{StaticResource Desk.Button}" Click="StackedConstraints_Click"><StackPanel><TextBlock Text="{DynamicResource Stack.Title}" Style="{StaticResource Desk.Label}"/><TextBlock Text="{DynamicResource Ai.Flow.Rhythm}" Style="{StaticResource Desk.Note}"/></StackPanel></Button>
    </Grid>
    <Path Data="M 0,0 L 0,5 L 50,16 L 100,5 L 100,0 M 50,16 L 50,22" Stroke="{DynamicResource Desk.Line}" StrokeThickness="1" Stretch="Fill" Height="25.4" Margin="24,2"/>
    <Button x:Name="AiPlanButton" Style="{StaticResource Desk.Button}" Click="AiPlan_Click"><StackPanel><TextBlock Text="{DynamicResource Ai.Step.AiPlan}" Style="{StaticResource Desk.Label}"/><TextBlock Text="{DynamicResource Ai.Flow.Optional}" Style="{StaticResource Desk.Note}"/></StackPanel></Button>
    <TextBlock x:Name="ProposalState" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Desk.Green}" Margin="0,6" Visibility="Collapsed"/>
    <TextBlock x:Name="DraftState" Text="{DynamicResource Ai.Flow.Draft}" TextWrapping="Wrap" Foreground="{DynamicResource Desk.Warning}" FontSize="12" Visibility="Collapsed"/>
    <Button x:Name="GenerateButton" Style="{StaticResource Desk.Primary}" Margin="0,10,0,6" Click="Generate_Click"><TextBlock Text="{DynamicResource Ai.Step.Generate}" Style="{StaticResource Desk.Label}"/></Button>
    <Border Height="1" Background="{DynamicResource Desk.Line}" Margin="0,12"/>
    <TextBlock Text="{DynamicResource Ai.Flow.Check}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Button x:Name="ReviewButton" Style="{StaticResource Desk.Button}" Click="Review_Click"><TextBlock Text="{DynamicResource Ai.Step.Review}" Style="{StaticResource Desk.Label}"/></Button>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="AuditButton" Style="{StaticResource Desk.Button}" Click="Audit_Click"><StackPanel><TextBlock Text="{DynamicResource Ai.Step.Audit}" Style="{StaticResource Desk.Label}"/><TextBlock x:Name="AuditState" Style="{StaticResource Desk.Note}"/></StackPanel></Button>
     <Button x:Name="PlanCheckButton" Grid.Column="2" Style="{StaticResource Desk.Button}" Click="PlanCheck_Click"><StackPanel><TextBlock Text="{DynamicResource Ai.Flow.PlanCheck}" Style="{StaticResource Desk.Label}"/><TextBlock x:Name="CheckState" Style="{StaticResource Desk.Note}"/></StackPanel></Button>
    </Grid>
    <Path Data="M 0,0 L 0,5 L 50,16 L 100,5 L 100,0 M 50,16 L 50,22" Stroke="{DynamicResource Desk.Line}" StrokeThickness="1" Stretch="Fill" Height="25.4" Margin="24,2"/>
    <Button x:Name="BodyRevisionButton" Style="{StaticResource Desk.Button}" Click="BodyRevision_Click"><TextBlock Text="{DynamicResource Ai.Revision.Title}" Style="{StaticResource Desk.Label}"/></Button>
    <TextBlock Text="{DynamicResource Ai.Flow.RevisionSteps}" Style="{StaticResource Desk.Note}"/>
    <TextBlock Text="{DynamicResource Ai.Flow.Invalidate}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Desk.Muted}" Margin="0,14,0,4"/>
    <Border Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource Desk.Line}" BorderThickness="0,1,0,0">
     <StackPanel>
      <Button x:Name="FinalizeButton" Style="{StaticResource Desk.Button}" Click="Finalize_Click"><TextBlock Text="{DynamicResource Ai.Flow.Finalize}" Style="{StaticResource Desk.Label}"/></Button>
      <TextBlock x:Name="SummaryState" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Desk.Muted}" Margin="0,17"/>
      <Button x:Name="ExtractButton" Style="{StaticResource Desk.Button}" Click="Extract_Click"><TextBlock Text="{DynamicResource Ai.Step.Extract}" Style="{StaticResource Desk.Label}"/></Button>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
