<Window x:Class="NovelGm.Desktop.Controls.ChapterStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Tools.Stats.Title}"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <StackPanel Margin="20,18,20,16">
    <TextBlock x:Name="ChapterText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
               TextTrimming="CharacterEllipsis"/>
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Tools.Stats.Words}" Margin="0,0,0,8"/>
      <TextBlock x:Name="WordsText" Grid.Column="1" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold"
                 HorizontalAlignment="Right"/>
      <TextBlock Grid.Row="1" Text="{DynamicResource Tools.Stats.Paragraphs}" Margin="0,0,0,8"/>
      <TextBlock x:Name="ParagraphsText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold"
                 HorizontalAlignment="Right"/>
      <TextBlock Grid.Row="2" Text="{DynamicResource Tools.Stats.Selection}"/>
      <TextBlock x:Name="SelectionText" Grid.Row="2" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                 HorizontalAlignment="Right"/>
    </Grid>
    <TextBlock Text="{DynamicResource Tools.Stats.Note}" Margin="0,14,0,0" FontSize="12"
               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    <Button Content="{DynamicResource Common.Close}" IsCancel="True" HorizontalAlignment="Right"
            Margin="0,14,0,0" MinWidth="88" Click="Close_Click"/>
  </StackPanel>
</Window>
