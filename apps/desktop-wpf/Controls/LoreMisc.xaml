<UserControl x:Class="NovelGm.Desktop.Controls.LoreMisc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="MinHeight" Value="72"/>
      <Setter Property="MaxHeight" Value="160"/>
    </Style>
    <Style x:Key="TextAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RuleButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="4,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel Margin="8">
    <Border x:Name="SaveBar" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrushKey}"
            BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
      <Grid x:Name="SaveGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="StatusRow" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                   Fill="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="SaveButton" Grid.Column="1" Content="{DynamicResource Misc.Save}" MinWidth="112" MinHeight="32"
                HorizontalAlignment="Right" IsEnabled="False" Style="{DynamicResource PrimaryButton}" Click="Save_Click"/>
      </Grid>
    </Border>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Form">
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SelectedBgBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Misc.ScopeBadge}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
          </Border>
          <TextBlock Grid.Column="1" Text="{DynamicResource Misc.ScopeLine}" Style="{StaticResource Hint}"
                     Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="Columns">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ColumnGap" Width="16"/>
            <ColumnDefinition x:Name="RulesColumnDef" Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="StyleColumn">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Path Data="M2,12 L4,14 L13,5 L11,3 Z M11,3 L13,1 L15,3 L13,5" Stroke="{DynamicResource TextBrush}"
                    StrokeThickness="1.2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Misc.StyleGroup}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Misc.SentenceRow}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
            <Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
              <UniformGrid Columns="3">
                <RadioButton x:Name="SentenceTerse" Content="{DynamicResource Misc.SentenceShort}" Tag="terse"
                             GroupName="MiscSentence" Style="{StaticResource Segment}"
                             BorderBrush="{DynamicResource BorderBrushKey}" Checked="Sentence_Checked"/>
                <RadioButton x:Name="SentenceMedium" Content="{DynamicResource Misc.SentenceMedium}" Tag="medium"
                             GroupName="MiscSentence" Style="{StaticResource Segment}"
                             BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1,0,0,0" Checked="Sentence_Checked"/>
                <RadioButton x:Name="SentenceLong" Content="{DynamicResource Misc.SentenceLong}" Tag="long"
                             GroupName="MiscSentence" Style="{StaticResource Segment}"
                             BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1,0,0,0" Checked="Sentence_Checked"/>
              </UniformGrid>
            </Border>
            <TextBlock Text="{DynamicResource Misc.SentenceHint}" Style="{StaticResource Hint}" Margin="0,6,0,14"/>

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource Misc.Samples}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
              <TextBlock x:Name="SampleCountText" Grid.Column="1" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
            </Grid>
            <StackPanel x:Name="EmptySamples">
              <TextBlock Text="{DynamicResource Misc.SamplesGuide}" Style="{StaticResource Hint}"/>
              <Button x:Name="EmptyAddButton" Content="{DynamicResource Misc.AddReference}" Style="{StaticResource TextAction}"
                      Click="AddSample_Click"/>
            </StackPanel>
            <Border x:Name="SamplePreviewCard" Visibility="Collapsed" Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,6" ClipToBounds="True">
              <TextBlock x:Name="SamplePreviewText" TextWrapping="Wrap" MaxHeight="64"
                         Foreground="{DynamicResource TextBrush}" ClipToBounds="True"/>
            </Border>
            <Grid x:Name="SampleFooter" Visibility="Collapsed" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource Misc.PreviewUse}" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
              <Button x:Name="SampleEditButton" Grid.Column="1" Content="{DynamicResource Misc.Edit}"
                      Style="{StaticResource TextAction}" Click="ToggleSamples_Click"/>
              <Button x:Name="SampleMoreButton" Grid.Column="2" Content="{DynamicResource Misc.More}"
                      Style="{StaticResource TextAction}" Click="OpenMenu_Click">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem x:Name="SampleAddMenu" Header="{DynamicResource Misc.AddReference}" Click="AddSample_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>
            <StackPanel x:Name="SamplesBody" Visibility="Collapsed" Margin="0,4,0,0">
              <TextBlock x:Name="SamplesDetail" Text="{DynamicResource Misc.SamplesHint}" Style="{StaticResource Hint}"/>
              <StackPanel x:Name="SampleList"/>
              <Button x:Name="ExtraToggle" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource TextAction}"
                      Click="ToggleExtras_Click"/>
              <StackPanel x:Name="ExtraHost" Visibility="Collapsed">
                <StackPanel x:Name="ExtraList"/>
              </StackPanel>
              <Button x:Name="AddSampleButton" Content="{DynamicResource Misc.AddSample}" Style="{StaticResource TextAction}"
                      Click="AddSample_Click"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="RulesColumn" Grid.Column="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Path Data="M3,1 H9 L13,5 V15 H3 Z M9,1 V5 H13" Stroke="{DynamicResource TextBrush}"
                    StrokeThickness="1.2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Misc.RulesGroup}" Style="{StaticResource SectionTitle}"/>
            </StackPanel>

            <Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="0,2">
              <StackPanel>
                <Button x:Name="ForbiddenToggle" Style="{StaticResource RuleButton}" Tag="forbidden" Click="Rule_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Misc.Forbidden}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="ForbiddenHeader" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Path x:Name="ForbiddenChevron" Grid.Column="2" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="1.4" Width="8" Height="10" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <TextBlock x:Name="ForbiddenPreview" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,6"/>
                <Border x:Name="ForbiddenBody" Visibility="Collapsed" Background="{DynamicResource SelectedBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBox x:Name="ForbiddenBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                    <TextBlock Text="{DynamicResource Misc.ForbiddenNote}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <Button x:Name="ForbiddenHelp" Content="{DynamicResource Misc.Help}" Style="{StaticResource TextAction}" Tag="ForbiddenDetail" Click="Help_Click"/>
                    <TextBlock x:Name="ForbiddenDetail" Text="{DynamicResource Misc.ForbiddenHint}" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="0,2">
              <StackPanel>
                <Button x:Name="BannedToggle" Style="{StaticResource RuleButton}" Tag="banned" Click="Rule_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Misc.Banned}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="BannedHeader" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Path x:Name="BannedChevron" Grid.Column="2" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="1.4" Width="8" Height="10" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <TextBlock x:Name="BannedPreview" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,6"/>
                <Border x:Name="BannedBody" Visibility="Collapsed" Background="{DynamicResource SelectedBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Misc.BannedLimit}" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="BannedBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                    <TextBlock Text="{DynamicResource Misc.KeepDefault}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <Button Content="{DynamicResource Misc.Help}" Style="{StaticResource TextAction}" Tag="BannedDetail" Click="Help_Click"/>
                    <TextBlock x:Name="BannedDetail" Text="{DynamicResource Misc.BannedHint}" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="0,2">
              <StackPanel>
                <Button x:Name="ReplaceToggle" Style="{StaticResource RuleButton}" Tag="replace" Click="Rule_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Misc.Replace}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="ReplaceHeader" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Path x:Name="ReplaceChevron" Grid.Column="2" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="1.4" Width="8" Height="10" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <TextBlock x:Name="ReplacePreview" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,6"/>
                <Border x:Name="ReplaceBody" Visibility="Collapsed" Background="{DynamicResource SelectedBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Misc.ReplaceLimit}" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="ReplaceBox" Style="{StaticResource Field}" TextChanged="Field_Changed"/>
                    <TextBlock Text="{DynamicResource Misc.NoAutoReplace}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource Misc.KeepDefault}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    <Button Content="{DynamicResource Misc.Help}" Style="{StaticResource TextAction}" Tag="ReplaceDetail" Click="Help_Click"/>
                    <TextBlock x:Name="ReplaceDetail" Text="{DynamicResource Misc.ReplaceHint}" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,16,0,0">
          <Button x:Name="DiagnosticsToggle" Style="{StaticResource RuleButton}" Click="Diagnostics_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DiagnosticsHeader" Text="{DynamicResource Misc.Diagnostics}" Foreground="{DynamicResource MutedBrush}"/>
              <Path x:Name="DiagnosticsChevron" Grid.Column="1" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource MutedBrush}"
                    StrokeThickness="1.4" Width="8" Height="10" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <StackPanel x:Name="DiagnosticsBody" Visibility="Collapsed" Margin="0,4,0,0">
            <TextBlock Text="{DynamicResource Misc.Metrics}" Style="{StaticResource Hint}"/>
            <TextBox x:Name="MetricsBox" IsReadOnly="True" Style="{StaticResource Field}" MinHeight="40"/>
            <TextBlock Text="{DynamicResource Misc.Compiled}" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
            <TextBox x:Name="CompiledBox" IsReadOnly="True" Style="{StaticResource Field}" MinHeight="72"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
