<Window x:Class="NovelGm.Desktop.Controls.SensitiveWordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Sens.Title}" Width="960" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15"
               Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
               Text="{DynamicResource Sens.Title}"/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Close}" IsCancel="True" Width="88"
              Click="Close_Click"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                 Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}"/>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 词库 -->
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Sens.Words}" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{DynamicResource TextBrush}"/>
        <Border DockPanel.Dock="Top" Style="{DynamicResource LoreBox}" MinHeight="180">
          <ListBox x:Name="WordList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>
        <TextBlock x:Name="LibraryHint" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Margin="2,6,0,4"
                   Foreground="{DynamicResource MutedBrush}"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <TextBox x:Name="WordBox" KeyDown="WordBox_KeyDown"/>
            <TextBlock Text="{DynamicResource Sens.WordPlaceholder}" Style="{DynamicResource BoxPlaceholder}"
                       Tag="{Binding Text, ElementName=WordBox}"/>
          </Grid>
          <Button Grid.Column="1" Content="{DynamicResource Sens.Add}" Click="Add_Click"
                  Margin="4,0,0,0" Padding="8,2" MinHeight="26" FontSize="12"/>
        </Grid>
        <WrapPanel>
          <Button Content="{DynamicResource Sens.Delete}" Click="Delete_Click" Padding="8,2"
                  MinHeight="26" FontSize="12"/>
          <Button Content="{DynamicResource Sens.Import}" Click="Import_Click" Padding="8,2"
                  MinHeight="26" FontSize="12"/>
          <Button Content="{DynamicResource Sens.Export}" Click="Export_Click" Padding="8,2"
                  MinHeight="26" FontSize="12"/>
        </WrapPanel>
      </DockPanel>

      <!-- 检测 -->
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="RescanButton" DockPanel.Dock="Right" Content="{DynamicResource Sens.Rescan}"
                  Click="Rescan_Click" Padding="8,2" MinHeight="26" FontSize="12"/>
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="ScopeChapterButton" Content="{DynamicResource Sens.Scope.Chapter}"
                          Style="{DynamicResource ZoneToggle}" Click="ScopeChapter_Click" IsChecked="True"/>
            <ToggleButton x:Name="ScopeBookButton" Content="{DynamicResource Sens.Scope.Book}"
                          Style="{DynamicResource ZoneToggle}" Click="ScopeBook_Click"/>
          </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Sens.Hint}" TextWrapping="Wrap"
                   FontSize="12" Margin="2,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
        <Grid>
          <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" Margin="0,0,6,0"/>
          </ScrollViewer>
          <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Margin="4,8,4,0" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                     Visibility="Collapsed"/>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
