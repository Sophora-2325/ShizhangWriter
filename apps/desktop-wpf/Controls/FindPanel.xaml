<UserControl x:Class="NovelGm.Desktop.Controls.FindPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource BgBrush}">
 <UserControl.Resources>
  <Style x:Key="FindIcon" TargetType="Button">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="6"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FindInput" TargetType="TextBox">
   <Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="38"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border Padding="4,0">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SearchPill" TargetType="Border">
   <Setter Property="Height" Value="40"/>
   <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/><Setter Property="CornerRadius" Value="20"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FindCheck" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrushKey}">
      <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{DynamicResource PrimaryFgBrush}" StrokeThickness="1.8" Visibility="Collapsed" Margin="-1"/>
     </Border>
     <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsChecked" Value="{x:Null}">
      <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter TargetName="Mark" Property="Data" Value="M4,8 L12,8"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="10,10,10,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource SearchPill}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
      <Path Data="M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 M11,11 L16,16" Stroke="{DynamicResource TextBrush}" Opacity="0.7" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
      <Grid Grid.Column="1">
       <TextBox x:Name="QueryBox" Style="{StaticResource FindInput}" TextChanged="Query_Changed" KeyDown="Query_KeyDown" MinHeight="38" AutomationProperties.Name="{DynamicResource Find.QueryPlaceholder}"/>
       <TextBlock Text="{DynamicResource Find.QueryPlaceholder}" Style="{DynamicResource BoxPlaceholder}" Foreground="{DynamicResource TextBrush}" Opacity="0.7" Tag="{Binding Text, ElementName=QueryBox}" Margin="4,0" VerticalAlignment="Center" FontSize="14"/>
      </Grid>
      <Button x:Name="ClearQueryButton" Grid.Column="2" Style="{StaticResource FindIcon}" Width="28" Click="ClearQuery_Click" ToolTip="{DynamicResource Find.Clear}" AutomationProperties.Name="{DynamicResource Find.Clear}">
       <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
      </Button>
     </Grid>
    </Border>
    <Button x:Name="ToggleReplaceButton" Grid.Column="1" Style="{StaticResource FindIcon}" Margin="4,0,0,0" Click="ToggleReplace_Click" ToolTip="{DynamicResource Find.ToggleReplace}" AutomationProperties.Name="{DynamicResource Find.ToggleReplace}">
     <Path x:Name="ToggleReplaceIcon" Data="M1,5 L16,5 L12,1 M16,12 L1,12 L5,16" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
    </Button>
   </Grid>
   <Grid x:Name="ReplaceRow" Margin="0,6,0,0" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource SearchPill}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="ReplaceButton" Style="{StaticResource FindIcon}" Width="30" Click="Replace_Click" ToolTip="{DynamicResource Find.ReplaceTip}" AutomationProperties.Name="{DynamicResource Find.Replace}">
       <Path Data="M1,5 L16,5 L12,1 M16,12 L1,12 L5,16" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
      </Button>
      <Grid Grid.Column="1" Margin="0,0,10,0">
       <TextBox x:Name="ReplaceBox" Style="{StaticResource FindInput}" TextChanged="Replace_Changed" MinHeight="38" AutomationProperties.Name="{DynamicResource Find.ReplacePlaceholder}"/>
       <TextBlock Text="{DynamicResource Find.ReplacePlaceholder}" Style="{DynamicResource BoxPlaceholder}" Foreground="{DynamicResource TextBrush}" Opacity="0.7" Tag="{Binding Text, ElementName=ReplaceBox}" Margin="4,0" VerticalAlignment="Center" FontSize="14"/>
      </Grid>
     </Grid>
    </Border>
    <Button x:Name="ReplaceAllButton" Grid.Column="1" Style="{StaticResource FindIcon}" Margin="4,0,0,0" Click="ReplaceAll_Click" ToolTip="{DynamicResource Find.ReplaceAllTip}" AutomationProperties.Name="{DynamicResource Find.ReplaceAll}">
     <Path Data="M4,1 L15,1 L15,12 M1,4 L12,4 L12,15 L1,15 Z M3,8 L9,8 L7,6 M9,11 L3,11 L5,13" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/>
    </Button>
   </Grid>
   <UniformGrid Columns="2" Margin="0,10,0,4">
    <ToggleButton x:Name="ScopeChapterButton" Content="{DynamicResource Find.Scope.Chapter}" Style="{DynamicResource ZoneToggle}" Click="ScopeChapter_Click" IsChecked="True" ToolTip="{DynamicResource Find.Scope.ChapterTip}"/>
    <ToggleButton x:Name="ScopeBookButton" Content="{DynamicResource Find.Scope.Book}" Style="{DynamicResource ZoneToggle}" Click="ScopeBook_Click" ToolTip="{DynamicResource Find.Scope.BookTip}"/>
   </UniformGrid>
   <DockPanel Margin="2,0,0,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="PrevButton" Style="{StaticResource FindIcon}" Click="Prev_Click" ToolTip="{DynamicResource Find.PrevTip}" AutomationProperties.Name="{DynamicResource Find.Prev}">
      <Path Data="M1,8 L7,2 L13,8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="12" Height="8" Stretch="Uniform"/>
     </Button>
     <Button x:Name="NextButton" Style="{StaticResource FindIcon}" Click="Next_Click" ToolTip="{DynamicResource Find.NextTip}" AutomationProperties.Name="{DynamicResource Find.Next}">
      <Path Data="M1,2 L7,8 L13,2" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="12" Height="8" Stretch="Uniform"/>
     </Button>
    </StackPanel>
    <CheckBox x:Name="CaseBox" Style="{StaticResource FindCheck}" Padding="6,0,0,0" Content="Aa" Checked="Case_Changed" Unchecked="Case_Changed" ToolTip="{DynamicResource Find.CaseTip}" AutomationProperties.Name="{DynamicResource Find.CaseSensitive}" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="2,4,2,4" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.75"/>
  </StackPanel>
  <Grid Margin="12,8,12,12">
   <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ResultsPanel" Margin="0,0,4,0"/></ScrollViewer>
   <TextBlock x:Name="EmptyHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,8,2,0" FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.75" IsHitTestVisible="False"/>
  </Grid>
 </DockPanel>
</UserControl>
