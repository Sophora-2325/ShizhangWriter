<Window x:Class="NovelGm.Desktop.Controls.VersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Versions.Title}" Width="920" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15"
               Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="RestoreButton" Content="{DynamicResource Versions.Restore}"
                Style="{DynamicResource PrimaryButton}" Click="Restore_Click"/>
        <Button Content="{DynamicResource Common.Close}" IsCancel="True" Width="88" Click="Close_Click"/>
      </StackPanel>
      <TextBlock x:Name="ReadOnlyHint" Text="{DynamicResource Versions.ReadOnly}" Visibility="Collapsed"
                 VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0"
                 Foreground="{DynamicResource DangerBrush}"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                 Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}"/>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Versions.Title}" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{DynamicResource TextBrush}"/>
        <Border Style="{DynamicResource LoreBox}">
          <ListBox x:Name="VersionList" SelectionChanged="VersionList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Border>
      </DockPanel>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PreviewHeader" FontWeight="SemiBold" Margin="2,0,0,6" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"/>
        <Border Grid.Row="1" Style="{DynamicResource LoreBox}">
          <RichTextBox x:Name="PreviewBox" IsReadOnly="True" IsDocumentEnabled="False"
                       VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                       Padding="8" FontFamily="{DynamicResource BodyFontFamily}"
                       Foreground="{DynamicResource TextBrush}"/>
        </Border>
        <TextBlock x:Name="HintText" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Margin="2,6,0,0"
                   Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
