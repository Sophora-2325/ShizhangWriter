<UserControl x:Class="NovelGm.Desktop.Controls.NotesPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="NoteTool" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="32"/>
   <Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="1,0"/>
  </Style>
 </UserControl.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="12,10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="NewButton" Style="{StaticResource NoteTool}" Click="New_Click" ToolTip="{DynamicResource Notes.New}" AutomationProperties.Name="{DynamicResource Notes.New}">
      <Path Data="M8,1 L8,15 M1,8 L15,8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/>
     </Button>
     <Button x:Name="SortButton" Style="{StaticResource NoteTool}" Click="Sort_Click" ToolTip="{DynamicResource Notes.Sort}" AutomationProperties.Name="{DynamicResource Notes.Sort}">
      <Path Data="M4,1 L4,15 M1,12 L4,15 L7,12 M10,3 L17,3 M10,8 L15,8 M10,13 L13,13" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Width="17" Height="16" Stretch="Uniform"/>
     </Button>
     <Button x:Name="DeleteButton" Style="{StaticResource NoteTool}" Click="Delete_Click" ToolTip="{DynamicResource Notes.Delete}" AutomationProperties.Name="{DynamicResource Notes.Delete}">
      <Path Data="M2,4 L16,4 M6,4 L6,1 L12,1 L12,4 M4,4 L5,16 L13,16 L14,4 M7,7 L7,13 M11,7 L11,13" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Width="16" Height="17" Stretch="Uniform"/>
     </Button>
    </StackPanel>
    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource NoteTool}" Click="Finish_Click" Visibility="Collapsed" ToolTip="{DynamicResource Notes.Back}" AutomationProperties.Name="{DynamicResource Notes.Back}">
     <Path Data="M11,1 L4,8 L11,15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="8" Height="16" Stretch="Uniform"/>
    </Button>
    <TextBlock Text="{DynamicResource Notes.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <DockPanel DockPanel.Dock="Bottom" Margin="12,4,12,10">
   <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="{DynamicResource Notes.Retry}" Click="Retry_Click" Visibility="Collapsed" Padding="8,3"/>
   <TextBlock x:Name="StatusText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Margin="10,10,10,4">
   <ListBox x:Name="NoteList" SelectionChanged="NoteList_SelectionChanged" MouseDoubleClick="NoteList_DoubleClick" PreviewKeyDown="NoteList_KeyDown"
    AutomationProperties.Name="{DynamicResource Notes.Title}"
    BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <EventSetter Event="PreviewMouseRightButtonDown" Handler="NoteItem_RightClick"/>
     <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Row" MinHeight="52" Background="{DynamicResource Bg2Brush}" Padding="{TemplateBinding Padding}" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushKey}">
       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsSorting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
      <Button Content="{DynamicResource Notes.MoveUp}" Tag="up" Click="Move_Click" IsEnabled="{Binding CanMoveUp}" Padding="8,4"/>
      <Button Content="{DynamicResource Notes.MoveDown}" Tag="down" Click="Move_Click" IsEnabled="{Binding CanMoveDown}" Padding="8,4"/>
     </WrapPanel>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Grid x:Name="EditorGrid" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <TextBox x:Name="BodyBox" TextChanged="Editor_Changed" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="90" Padding="10" AutomationProperties.Name="{DynamicResource Notes.BodyPlaceholder}"/>
     <TextBlock Text="{DynamicResource Notes.BodyPlaceholder}" Style="{DynamicResource BoxPlaceholder}" Foreground="{DynamicResource TextBrush}" Opacity="0.7" Tag="{Binding Text, ElementName=BodyBox}"/>
    </Grid>
    <Button x:Name="SaveButton" Grid.Row="1" Content="{DynamicResource Notes.Save}" Style="{DynamicResource PrimaryButton}" Click="Finish_Click" Margin="0,12,0,6" Padding="18,9" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Notes.Save}"/>
   </Grid>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,30">
    <Button x:Name="EmptyCreateButton" Content="{DynamicResource Notes.CreateNow}" Style="{DynamicResource PrimaryButton}" Click="New_Click" Padding="18,7" HorizontalAlignment="Center"/>
   </StackPanel>
  </Grid>
 </DockPanel>
</UserControl>
