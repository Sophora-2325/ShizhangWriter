<UserControl x:Class="NovelGm.Desktop.Controls.AuditZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12,10,12,12">
    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Audit.Title}" FontWeight="Bold" FontSize="15"
               HorizontalAlignment="Center" FontFamily="{DynamicResource BodyFontFamily}"
               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

    <!-- 头部：本章 + 统计 + 重新审计 -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock x:Name="ChapterText" FontSize="13" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock x:Name="StatsText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock x:Name="PlanStatsText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
      <Button x:Name="ReauditButton" Grid.Column="1" Content="{DynamicResource Audit.Rerun}"
              Click="Reaudit_Click" MinWidth="92" Padding="12,4" VerticalAlignment="Center"
              ToolTip="{DynamicResource Audit.RerunTip}"/>
    </Grid>

    <!-- 计费说明：语义审计会真实花钱，必须写在这里 -->
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="9,7" CornerRadius="5"
            Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
            BorderThickness="1">
      <TextBlock Text="{DynamicResource Audit.Footer}" TextWrapping="Wrap" FontSize="12" LineHeight="17"
                 Foreground="{DynamicResource MutedBrush}"/>
    </Border>

    <Grid>
      <ScrollViewer x:Name="FlagScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="FlagList" Margin="0,0,6,0"/>
      </ScrollViewer>
      <!-- 空态不再需要一个居中大块：两段各自的说明文字直接排在列表里 -->
      <TextBlock x:Name="EmptyText" Visibility="Collapsed"/>
    </Grid>
  </DockPanel>
</UserControl>
