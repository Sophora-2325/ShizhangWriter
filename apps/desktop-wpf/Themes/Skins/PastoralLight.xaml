<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 青绿 · 浅色：田园风，青草与嫩叶的绿。 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/novel-gm;component/Themes/Light.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- 正文字体：田园风用稿纸味的仿宋 -->
  <FontFamily x:Key="BodyFontFamily">Cambria, FangSong, 仿宋</FontFamily>

  <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="#F2F8F3"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PageBrush" Color="#EDF6EF"/>
  <SolidColorBrush x:Key="ControlBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="#CFE3D4"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#BDD8C4"/>
  <SolidColorBrush x:Key="TextBrush" Color="#22352B"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#778F80"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#AEC4B5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0B8A5F"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#26A077"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#E05252"/>
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InfoBgBrush" Color="#E3F6EE"/>
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#A7E0C6"/>
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#C6EEDD"/>
  <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF7E6"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFE0A3"/>
  <SolidColorBrush x:Key="ToolHoverBrush" Color="#EDF6F0"/>

  <SolidColorBrush x:Key="SidebarBrush" Color="#F7FBF7"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E9F4EC"/>
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="#DAEDE0"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E3F6EE"/>

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#BFD8C6"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A0C2AB"/>

  <!-- settings window -->
  <SolidColorBrush x:Key="SetLineBrush" Color="#E9F2EB"/>
  <SolidColorBrush x:Key="SetCardBorderBrush" Color="#D8E8DC"/>
  <SolidColorBrush x:Key="SetNavHoverBrush" Color="#F1F8F2"/>
  <SolidColorBrush x:Key="SetNavSelectedBrush" Color="#E4F1E7"/>
  <SolidColorBrush x:Key="SetButtonHoverBrush" Color="#F5FAF6"/>
  <SolidColorBrush x:Key="SetFieldBrush" Color="#F0F7F2"/>
  <SolidColorBrush x:Key="SetStrongBrush" Color="#14532D"/>
  <SolidColorBrush x:Key="SetStrongFgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetStrongHoverBrush" Color="#1B6B3A"/>
  <SolidColorBrush x:Key="SetSwitchOffBrush" Color="#BFD8C6"/>
  <!-- OkBrush / SetOnlineBrush 是语义色（成功、在线），六套配色共用 Light.xaml 里的取值 -->
</ResourceDictionary>
