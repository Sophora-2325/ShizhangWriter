<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 樱紫 · 浅色：二次元风的樱花紫。先合并基础浅色板保底，再覆盖配色键。 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/novel-gm;component/Themes/Light.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- 正文字体：二次元风用手写味的楷体 -->
  <FontFamily x:Key="BodyFontFamily">Cambria, KaiTi, 楷体</FontFamily>

  <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="#FBF5FF"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PageBrush" Color="#F7F0FC"/>
  <SolidColorBrush x:Key="ControlBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="#EBD8F5"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#E0C8ED"/>
  <SolidColorBrush x:Key="TextBrush" Color="#2E2438"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#8A7A99"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#C9B8D6"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#A855F7"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#B072EC"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#E8447A"/>
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InfoBgBrush" Color="#F6E9FF"/>
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#D8B4FE"/>
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#EBD5FF"/>
  <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF1F6"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFC9DE"/>
  <SolidColorBrush x:Key="ToolHoverBrush" Color="#F4E9FC"/>

  <SolidColorBrush x:Key="SidebarBrush" Color="#FAF3FF"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#F0E2FB"/>
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="#E7D4F7"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#F2E2FF"/>

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D9C3E8"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#C2A6D6"/>

  <!-- settings window -->
  <SolidColorBrush x:Key="SetLineBrush" Color="#F2E6FA"/>
  <SolidColorBrush x:Key="SetCardBorderBrush" Color="#EDDCF7"/>
  <SolidColorBrush x:Key="SetNavHoverBrush" Color="#F6ECFD"/>
  <SolidColorBrush x:Key="SetNavSelectedBrush" Color="#EFE0FA"/>
  <SolidColorBrush x:Key="SetButtonHoverBrush" Color="#F8F0FE"/>
  <SolidColorBrush x:Key="SetFieldBrush" Color="#F6EEFC"/>
  <SolidColorBrush x:Key="SetStrongBrush" Color="#7E22CE"/>
  <SolidColorBrush x:Key="SetStrongFgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetStrongHoverBrush" Color="#9333EA"/>
  <SolidColorBrush x:Key="SetSwitchOffBrush" Color="#D9C3E8"/>
  <!-- OkBrush / SetOnlineBrush 是语义色（成功、在线），六套配色共用 Light.xaml 里的取值 -->
</ResourceDictionary>
