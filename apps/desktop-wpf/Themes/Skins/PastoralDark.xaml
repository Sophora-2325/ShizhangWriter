<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 青绿 · 深色：夜里温室的墨绿 + 薄荷点缀。 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/novel-gm;component/Themes/Dark.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- 正文字体：田园风用稿纸味的仿宋 -->
  <FontFamily x:Key="BodyFontFamily">Cambria, FangSong, 仿宋</FontFamily>

  <SolidColorBrush x:Key="BgBrush" Color="#16201B"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="#1B2620"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="#202D26"/>
  <SolidColorBrush x:Key="PageBrush" Color="#111A15"/>
  <SolidColorBrush x:Key="ControlBgBrush" Color="#1B2620"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="#2F4038"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#35473E"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E3EFE7"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#92A99B"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#66796E"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#34D399"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#6EE7B7"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="#0B2A1D"/>
  <SolidColorBrush x:Key="InfoBgBrush" Color="#17392C"/>
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#276048"/>
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#1E4A38"/>
  <SolidColorBrush x:Key="WarningBgBrush" Color="#3A3018"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4C26"/>
  <SolidColorBrush x:Key="ToolHoverBrush" Color="#22322A"/>

  <SolidColorBrush x:Key="SidebarBrush" Color="#131C17"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#233029"/>
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="#2B3B32"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#17392C"/>

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A5045"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4B655A"/>

  <!-- settings window -->
  <SolidColorBrush x:Key="SetLineBrush" Color="#22322A"/>
  <SolidColorBrush x:Key="SetCardBorderBrush" Color="#2B3E34"/>
  <SolidColorBrush x:Key="SetNavHoverBrush" Color="#1F2E27"/>
  <SolidColorBrush x:Key="SetNavSelectedBrush" Color="#26382F"/>
  <SolidColorBrush x:Key="SetButtonHoverBrush" Color="#22322A"/>
  <SolidColorBrush x:Key="SetFieldBrush" Color="#1F2E27"/>
  <SolidColorBrush x:Key="SetStrongBrush" Color="#D1FAE5"/>
  <SolidColorBrush x:Key="SetStrongFgBrush" Color="#0B2A1D"/>
  <SolidColorBrush x:Key="SetStrongHoverBrush" Color="#A7F3D0"/>
  <SolidColorBrush x:Key="SetSwitchOffBrush" Color="#3A5045"/>
  <!-- OkBrush / SetOnlineBrush 是语义色（成功、在线），六套配色共用 Dark.xaml 里的取值 -->
</ResourceDictionary>
