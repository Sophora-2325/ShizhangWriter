<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 樱紫 · 深色：梅子色底 + 樱花紫点缀。 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/novel-gm;component/Themes/Dark.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- 正文字体：二次元风用手写味的楷体 -->
  <FontFamily x:Key="BodyFontFamily">Cambria, KaiTi, 楷体</FontFamily>

  <SolidColorBrush x:Key="BgBrush" Color="#241C2E"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="#2B2136"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="#31263D"/>
  <SolidColorBrush x:Key="PageBrush" Color="#1B1422"/>
  <SolidColorBrush x:Key="ControlBgBrush" Color="#2A2034"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="#453354"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#4A3659"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F0E6F8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A895B8"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#7A6889"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#C084FC"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#D8B4FE"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FF85A8"/>
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="#2A1A38"/>
  <SolidColorBrush x:Key="InfoBgBrush" Color="#3B2456"/>
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#5B3A80"/>
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#4A2C6B"/>
  <SolidColorBrush x:Key="WarningBgBrush" Color="#3A1E30"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C2B48"/>
  <SolidColorBrush x:Key="ToolHoverBrush" Color="#35283F"/>

  <SolidColorBrush x:Key="SidebarBrush" Color="#1F1828"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#302440"/>
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="#3A2C4B"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3B2456"/>

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4E3B60"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#624B76"/>

  <!-- settings window -->
  <SolidColorBrush x:Key="SetLineBrush" Color="#332742"/>
  <SolidColorBrush x:Key="SetCardBorderBrush" Color="#3D2F4D"/>
  <SolidColorBrush x:Key="SetNavHoverBrush" Color="#2E2340"/>
  <SolidColorBrush x:Key="SetNavSelectedBrush" Color="#392A4C"/>
  <SolidColorBrush x:Key="SetButtonHoverBrush" Color="#332742"/>
  <SolidColorBrush x:Key="SetFieldBrush" Color="#302440"/>
  <SolidColorBrush x:Key="SetStrongBrush" Color="#E9D5FF"/>
  <SolidColorBrush x:Key="SetStrongFgBrush" Color="#2A1A38"/>
  <SolidColorBrush x:Key="SetStrongHoverBrush" Color="#D8B4FE"/>
  <SolidColorBrush x:Key="SetSwitchOffBrush" Color="#4E3B60"/>
  <!-- OkBrush / SetOnlineBrush 是语义色（成功、在线），六套配色共用 Dark.xaml 里的取值 -->
</ResourceDictionary>
