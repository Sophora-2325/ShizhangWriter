<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 蓝白 · 浅色：校园风，纯白底 + 校服蓝（比经典的 Ant Design 蓝更深、更冷）。 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/novel-gm;component/Themes/Light.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- 正文字体：校园风用清爽的等线，配 Segoe UI 的拉丁 -->
  <FontFamily x:Key="BodyFontFamily">Segoe UI, DengXian, 等线</FontFamily>

  <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="#F2F7FF"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PageBrush" Color="#E8F1FF"/>
  <SolidColorBrush x:Key="ControlBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="#CBDDF5"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#B9CFEE"/>
  <SolidColorBrush x:Key="TextBrush" Color="#14213D"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#6B7F9E"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#A3B8D4"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InfoBgBrush" Color="#DCE9FF"/>
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#9DC0FF"/>
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#CBDFFF"/>
  <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF4E5"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFD8A8"/>
  <SolidColorBrush x:Key="ToolHoverBrush" Color="#E9F1FD"/>

  <SolidColorBrush x:Key="SidebarBrush" Color="#F4F9FF"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E3EEFE"/>
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="#D3E3FB"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#DCE9FF"/>

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B7CDEA"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#97B2D6"/>

  <!-- settings window -->
  <SolidColorBrush x:Key="SetLineBrush" Color="#E6EFFB"/>
  <SolidColorBrush x:Key="SetCardBorderBrush" Color="#D5E4F7"/>
  <SolidColorBrush x:Key="SetNavHoverBrush" Color="#EDF4FE"/>
  <SolidColorBrush x:Key="SetNavSelectedBrush" Color="#DCE9FF"/>
  <SolidColorBrush x:Key="SetButtonHoverBrush" Color="#F3F8FF"/>
  <SolidColorBrush x:Key="SetFieldBrush" Color="#EDF4FE"/>
  <SolidColorBrush x:Key="SetStrongBrush" Color="#1E3A8A"/>
  <SolidColorBrush x:Key="SetStrongFgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SetStrongHoverBrush" Color="#1D4ED8"/>
  <SolidColorBrush x:Key="SetSwitchOffBrush" Color="#B7CDEA"/>
  <!-- OkBrush / SetOnlineBrush 是语义色（成功、在线），六套配色共用 Light.xaml 里的取值 -->
</ResourceDictionary>
