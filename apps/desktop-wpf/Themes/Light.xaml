<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 校样台 · 浅色中性底；Themes/Accents/*Light.xaml 覆盖强调派生键，Dark.xaml 必须定义同一组键 -->
  <!-- 正文字体：书写面字体。拉丁走 Cambria，中文走宋体（出版物内文） -->
  <FontFamily x:Key="BodyFontFamily">Cambria, SimSun, 宋体</FontFamily>

  <SolidColorBrush x:Key="BgBrush" Color="#FCFBF7"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="#F4F3EF"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="#FCFBF7"/>
  <SolidColorBrush x:Key="PageBrush" Color="#F4F3EF"/>
  <SolidColorBrush x:Key="ControlBgBrush" Color="#FCFBF7"/>
  <SolidColorBrush x:Key="BorderBrushKey" Color="#E2DFD8"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#DCD8CE"/>
  <SolidColorBrush x:Key="TextBrush" Color="#16181B"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#62666C"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#77736A"/>
  <!-- 强调默认朱砂；切换强调色时由 Themes/Accents 覆盖 -->
  <SolidColorBrush x:Key="AccentBrush" Color="#A6402E"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#8E3527"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#7C2E22"/>
  <SolidColorBrush x:Key="SelectedBarBrush" Color="#A6402E"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#A6402E"/>
  <SolidColorBrush x:Key="OkBrush" Color="#3F6B4F"/>
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FCFBF7"/>
  <SolidColorBrush x:Key="InfoBgBrush" Color="#F1DED8"/>
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#E0B9AF"/>
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#F1DED8"/>
  <SolidColorBrush x:Key="WarningBgBrush" Color="#F4EAD6"/>
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#DFC79A"/>
  <SolidColorBrush x:Key="ToolHoverBrush" Color="#EDEBE4"/>

  <!-- 评注/审计固定朱砂语义，不随强调色变化 -->
  <SolidColorBrush x:Key="ReviewBrush" Color="#A6402E"/>
  <SolidColorBrush x:Key="ReviewTintBrush" Color="#F1DED8"/>
  <SolidColorBrush x:Key="ReviewBorderBrush" Color="#E0B9AF"/>

  <SolidColorBrush x:Key="SidebarBrush" Color="#F4F3EF"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#EAE8E1"/>
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="#E0DDD4"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#F1DED8"/>

  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CFCCC2"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B4B0A6"/>

  <!-- settings window -->
  <SolidColorBrush x:Key="SetLineBrush" Color="#E7E4DC"/>
  <SolidColorBrush x:Key="SetCardBorderBrush" Color="#E2DFD8"/>
  <SolidColorBrush x:Key="SetNavHoverBrush" Color="#EAE8E1"/>
  <SolidColorBrush x:Key="SetNavSelectedBrush" Color="#E0DDD4"/>
  <SolidColorBrush x:Key="SetButtonHoverBrush" Color="#EDEBE4"/>
  <SolidColorBrush x:Key="SetFieldBrush" Color="#F4F3EF"/>
  <SolidColorBrush x:Key="SetStrongBrush" Color="#16181B"/>
  <SolidColorBrush x:Key="SetStrongFgBrush" Color="#FCFBF7"/>
  <SolidColorBrush x:Key="SetStrongHoverBrush" Color="#2E3136"/>
  <SolidColorBrush x:Key="SetSwitchOffBrush" Color="#CFCCC2"/>
  <SolidColorBrush x:Key="SetOnlineBrush" Color="#3F6B4F"/>
</ResourceDictionary>
