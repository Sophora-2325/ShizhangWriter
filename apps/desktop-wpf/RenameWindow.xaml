<Window x:Class="NovelGm.Desktop.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Rename.Title}" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{DynamicResource Common.Cancel}" Width="80" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="{DynamicResource Common.OK}" Width="80" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
    </StackPanel>
    <StackPanel>
      <Label x:Name="PromptLabel" Content="{DynamicResource Rename.NewName}"/>
      <TextBox x:Name="NameBox"/>
      <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
