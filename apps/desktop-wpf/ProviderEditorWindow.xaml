<Window x:Class="NovelGm.Desktop.ProviderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Prov.TitleNew}" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="PresetChip" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Preset"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource SetCardBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SetNavHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SetStrongBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SetStrongBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource SetStrongFgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="4,4,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,4,0,6"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="TestButton" Content="{DynamicResource Set.Test}" MinWidth="90" Click="Test_Click"/>
        <Button x:Name="FetchButton" Content="{DynamicResource Set.FetchModels}" MinWidth="110" Margin="8,0,0,0" Click="Fetch_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource Common.Cancel}" Width="80" IsCancel="True"/>
        <Button x:Name="SaveButton" Content="{DynamicResource Common.Save}" Width="80" Margin="8,0,0,0"
                Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
               Margin="0,8,0,0" Visibility="Collapsed"/>
    <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
               Margin="0,8,0,0" Visibility="Collapsed"/>

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
        <StackPanel x:Name="PresetSection">
          <Label Content="{DynamicResource Prov.Preset}"/>
          <StackPanel x:Name="PresetPanel" Margin="4,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="PresetFixedText" FontSize="13" Margin="4,0,0,6" Visibility="Collapsed"
                   Foreground="{DynamicResource MutedBrush}"/>

        <StackPanel x:Name="FormPanel">
          <Label Content="{DynamicResource Prov.Name}" Margin="0,4,0,0"/>
          <TextBox x:Name="NameBox"/>
          <TextBlock Text="{DynamicResource Prov.NameHint}" Style="{StaticResource Hint}"/>

          <StackPanel x:Name="KeySection">
            <Label Content="{DynamicResource Set.ApiKey}" Margin="0,6,0,0"/>
            <PasswordBox x:Name="KeyBox"/>
            <DockPanel Margin="0,0,0,0">
              <Button x:Name="ClearKeyButton" DockPanel.Dock="Right" Content="{DynamicResource Set.ClearKey}"
                      Style="{StaticResource QuietButton}" Margin="8,2,0,0" Visibility="Collapsed" Click="ClearKey_Click"/>
              <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}"/>
            </DockPanel>
          </StackPanel>

          <Label Content="{DynamicResource Set.BaseUrl}" Margin="0,6,0,0"/>
          <TextBox x:Name="BaseBox"/>
          <TextBlock x:Name="BaseHint" Style="{StaticResource Hint}"/>

          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <Label Content="{DynamicResource Set.ModelStrong}"/>
              <ComboBox x:Name="StrongBox" IsEditable="True" MaxDropDownHeight="320"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Label Content="{DynamicResource Set.ModelFast}"/>
              <ComboBox x:Name="FastBox" IsEditable="True" MaxDropDownHeight="320"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{DynamicResource Prov.ModelHint}" Style="{StaticResource Hint}"/>

          <Expander x:Name="AdvancedExpander" Header="{DynamicResource Prov.Advanced}" Margin="0,14,0,0">
            <StackPanel Margin="16,8,0,0">
              <CheckBox x:Name="ThinkingBox" Content="{DynamicResource Set.Thinking}" Margin="0,0,0,8"/>
              <TextBlock Text="{DynamicResource Set.Price}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                         TextWrapping="Wrap" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{DynamicResource Set.PriceInput}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                  <TextBox x:Name="PriceInBox" Width="110"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{DynamicResource Set.PriceCached}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                  <TextBox x:Name="PriceHitBox" Width="110"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Set.PriceOutput}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                  <TextBox x:Name="PriceOutBox" Width="110"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
