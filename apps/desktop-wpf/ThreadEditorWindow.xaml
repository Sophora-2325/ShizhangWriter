<Window x:Class="NovelGm.Desktop.ThreadEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Thread.Title}" Width="640" Height="640" MinWidth="480" MinHeight="400"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <DockPanel Margin="16">
  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="CancelButton" Content="{DynamicResource Common.Cancel}" MinWidth="80" Click="Cancel_Click"/>
    <Button x:Name="SaveButton" Content="{DynamicResource Common.Save}" MinWidth="80" Style="{DynamicResource PrimaryButton}" Click="Save_Click"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="EditorForm">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="450" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
     <Grid.RowDefinitions><RowDefinition Height="18*"/><RowDefinition Height="22*"/><RowDefinition Height="22*"/><RowDefinition Height="19*"/><RowDefinition Height="19*"/><RowDefinition Height="24*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Label Content="{DynamicResource Thread.NameReq}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="NameBox" Grid.Column="1" FontSize="18" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Thread.NameReq}"/>
     </Grid>
     <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12" VerticalAlignment="Center">
      <StackPanel Margin="0,0,8,0"><Label Content="{DynamicResource Thread.Kind}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Padding="0,4,0,6"/><ComboBox x:Name="KindCombo" FontSize="18" MinHeight="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectionChanged="Kind_Changed" AutomationProperties.Name="{DynamicResource Thread.Kind}"/></StackPanel>
      <StackPanel Margin="4,0,4,0"><Label Content="{DynamicResource Thread.State}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Padding="0,4,0,6"/><ComboBox x:Name="StateCombo" FontSize="18" MinHeight="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Thread.State}">
       <ComboBoxItem Content="{DynamicResource ThreadState.seed}" Tag="seed"/><ComboBoxItem Content="{DynamicResource ThreadState.active}" Tag="active"/>
       <ComboBoxItem Content="{DynamicResource ThreadState.climax}" Tag="climax"/><ComboBoxItem Content="{DynamicResource ThreadState.resolved}" Tag="resolved"/>
       <ComboBoxItem Content="{DynamicResource ThreadState.abandoned}" Tag="abandoned"/>
      </ComboBox></StackPanel>
      <StackPanel Margin="8,0,0,0"><Label Content="{DynamicResource Thread.Time}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Padding="0,4,0,6"/><ComboBox x:Name="TimeCombo" FontSize="18" MinHeight="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="{DynamicResource Thread.TimeHint}" AutomationProperties.Name="{DynamicResource Thread.Time}">
       <ComboBoxItem Content="{DynamicResource ThreadTime.past}" Tag="past"/><ComboBoxItem Content="{DynamicResource ThreadTime.present}" Tag="present"/><ComboBoxItem Content="{DynamicResource ThreadTime.future}" Tag="future"/>
      </ComboBox></StackPanel>
     </UniformGrid>
     <Button x:Name="DevelopmentButton" Grid.Row="2" Content="{DynamicResource Thread.Development}" Tag="development" Click="Section_Click" FontSize="18" Margin="0,4"/>
     <Button x:Name="MilestonesButton" Grid.Row="3" Tag="milestones" Click="Section_Click" Margin="0,4">
      <StackPanel><TextBlock Text="{DynamicResource Thread.Nodes}" FontSize="18" TextAlignment="Center"/><TextBlock Text="{DynamicResource Thread.Milestones}" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="ToneButton" Grid.Row="4" Content="{DynamicResource Thread.Tone}" Tag="tone" Click="Section_Click" FontSize="18" Margin="0,4"/>
     <Button x:Name="MiscButton" Grid.Row="5" Content="{DynamicResource Thread.Misc}" Tag="misc" Click="Section_Click" FontSize="18" Margin="0,4"/>
    </Grid>
   </ScrollViewer>
   <Border x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed" Margin="16,0,0,0" Padding="16,0,0,0" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1,0,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="DetailTitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
     <TextBox x:Name="DirectiveBox" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Thread.Development}"/>
     <TextBox x:Name="ToneBox" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Thread.Tone}"/>
     <TextBox x:Name="MiscBox" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Thread.Misc}"/>
     <DockPanel x:Name="MilestonePane" Grid.Row="1" Visibility="Collapsed">
      <Button x:Name="AddMilestoneButton" DockPanel.Dock="Bottom" Content="{DynamicResource Thread.AddMilestone}" Click="AddMilestone_Click" Margin="0,12,0,0"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MilestoneList"/></ScrollViewer>
     </DockPanel>
    </Grid>
   </Border>
  </Grid>
 </DockPanel>
</Window>
