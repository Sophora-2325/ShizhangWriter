<Window x:Class="NovelGm.Desktop.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Publish.Title}"
        Width="820" Height="620" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="GenerateButton" Content="{DynamicResource Publish.Generate}" MinWidth="120"
              Style="{StaticResource PrimaryButton}" Click="Generate_Click"/>
      <Button x:Name="CopyButton" Content="{DynamicResource Publish.Copy}" MinWidth="96" Click="Copy_Click"/>
      <Button x:Name="BackendButton" Content="{DynamicResource Publish.OpenBackend}" MinWidth="120" Click="Backend_Click"/>
      <Button Content="{DynamicResource Common.Close}" Width="80" IsCancel="True"/>
    </StackPanel>

    <!-- 顶部：发布范围 + 排版选项 -->
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{DynamicResource Publish.Scope}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <RadioButton x:Name="ScopeChapter" GroupName="Scope" VerticalAlignment="Center" Click="Scope_Click"/>
        <RadioButton x:Name="ScopeBook" GroupName="Scope" VerticalAlignment="Center" Margin="14,0,0,0" Click="Scope_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="{DynamicResource Publish.Indent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="IndentCombo" Width="140" DisplayMemberPath="Display"/>
        <TextBlock Text="{DynamicResource Publish.Head}" VerticalAlignment="Center" Margin="18,0,6,0"/>
        <ComboBox x:Name="HeadCombo" Width="140" DisplayMemberPath="Display"/>
      </StackPanel>
    </StackPanel>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="260"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <!-- 左：平台（按后端下发的分组渲染） -->
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="{DynamicResource Publish.Platforms}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="SelectAllButton" Content="{DynamicResource Publish.SelectAll}" MinWidth="62" Margin="10,0,0,0" Click="SelectAll_Click"/>
          <Button x:Name="ClearAllButton" Content="{DynamicResource Publish.ClearAll}" MinWidth="62" Margin="6,0,0,0" Click="ClearAll_Click"/>
        </StackPanel>
        <Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
            <StackPanel x:Name="PlatformPanel"/>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- 右：作者 / 简介 / 要求速查 / 生成结果 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="52"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="52"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
          <TextBlock Text="{DynamicResource Publish.Author}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="AuthorBox" Width="150" VerticalAlignment="Center"/>
          <TextBlock Text="{DynamicResource Publish.AuthorHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Publish.Synopsis}" Margin="0,0,0,4"/>
          <TextBlock x:Name="SynopsisHint" DockPanel.Dock="Bottom" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
          <TextBox x:Name="SynopsisBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="{DynamicResource Publish.Requirements}" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
            <StackPanel x:Name="RequirementsPanel"/>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,4">
          <TextBlock Text="{DynamicResource Publish.Results}" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,6">
            <StackPanel x:Name="ResultsPanel"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
