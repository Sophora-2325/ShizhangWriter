<Window x:Class="NovelGm.Desktop.SkillDiscoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Disc.Title}" Width="920" Height="660" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,100,0"/>
      <Button Content="{DynamicResource Common.Close}" HorizontalAlignment="Right" Width="80" IsCancel="True"/>
    </Grid>

    <TabControl x:Name="Tabs">
      <!-- GitHub -->
      <TabItem Header="{DynamicResource Disc.TabGithub}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Disc.Search}" Width="90" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
            <Grid>
              <TextBox x:Name="QueryBox" KeyDown="QueryBox_KeyDown"/>
              <TextBlock Text="{DynamicResource Disc.QueryPlaceholder}" Style="{StaticResource BoxPlaceholder}"
                         Tag="{Binding Text, ElementName=QueryBox}"/>
            </Grid>
          </DockPanel>
          <TextBlock x:Name="SearchHint" Grid.Row="1" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap" Margin="2,6,0,8"/>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="330"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
              <TextBlock x:Name="ResultsHeader" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="2,0,0,6"/>
              <Border Style="{StaticResource LoreBox}">
                <ListBox x:Name="ResultList" SelectionChanged="ResultList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              </Border>
            </DockPanel>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="FilesHeader" Text="{DynamicResource Disc.Files}" FontWeight="SemiBold" Margin="2,0,0,6"
                         TextWrapping="Wrap"/>
              <Border Grid.Row="1" Style="{StaticResource LoreBox}">
                <ListBox x:Name="FileList" SelectionChanged="FileList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              </Border>
              <DockPanel Grid.Row="2" Margin="0,10,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="OpenFileButton" Content="{DynamicResource Common.OpenBrowser}" IsEnabled="False"
                          Click="OpenFile_Click"/>
                  <Button x:Name="ImportFileButton" Content="{DynamicResource Disc.ImportDirect}" IsEnabled="False"
                          Click="ImportFile_Click"/>
                  <Button x:Name="DistillFileButton" Content="{DynamicResource Disc.Distill}" IsEnabled="False"
                          Style="{StaticResource PrimaryButton}" Click="DistillFile_Click"/>
                </StackPanel>
                <TextBlock x:Name="PreviewHeader" Text="{DynamicResource Disc.Preview}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,8,0"/>
              </DockPanel>
              <TextBox x:Name="PreviewBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="12"/>
            </Grid>
          </Grid>

          <Expander Grid.Row="3" Margin="0,12,0,0" Header="{DynamicResource Disc.Token}">
            <StackPanel Margin="16,8,0,0">
              <TextBlock Text="{DynamicResource Disc.TokenDesc}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                         TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <PasswordBox x:Name="TokenBox" Width="320" VerticalContentAlignment="Center"/>
                <Button Content="{DynamicResource Common.Save}" Margin="8,2,2,2" Click="SaveToken_Click"/>
                <Button Content="{DynamicResource Common.Clear}" Click="ClearToken_Click"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                  <Hyperlink NavigateUri="https://github.com/settings/tokens/new" RequestNavigate="Link_RequestNavigate">
                    <Run Text="{DynamicResource Disc.TokenCreate}"/>
                  </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="TokenState" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Expander>
        </Grid>
      </TabItem>

      <!-- link -->
      <TabItem Header="{DynamicResource Disc.TabLink}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0">
            <TextBlock Text="{DynamicResource Disc.LinkDesc}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"/>
            <Label Content="{DynamicResource Disc.LinkLabel}" Margin="0,10,0,0"/>
            <TextBox x:Name="UrlBox"/>
            <Label Content="{DynamicResource Disc.HintLabel}" Margin="0,6,0,0"/>
            <Grid>
              <TextBox x:Name="LinkHintBox"/>
              <TextBlock Text="{DynamicResource Disc.HintPlaceholder}" Style="{StaticResource BoxPlaceholder}"
                         Tag="{Binding Text, ElementName=LinkHintBox}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="{DynamicResource Disc.Distill}" Style="{StaticResource PrimaryButton}" Margin="0,2,8,2"
                      Click="DistillUrl_Click"/>
              <Button Content="{DynamicResource Disc.ImportDirect}" Click="ImportUrl_Click"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Disc.DistillCost}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="{DynamicResource Disc.Articles}" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <StackPanel x:Name="ArticleList"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- paste -->
      <TabItem Header="{DynamicResource Disc.TabPaste}">
        <DockPanel Margin="0,12,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Disc.PasteDesc}" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Label Content="{DynamicResource Disc.HintLabel}"/>
            <Grid>
              <TextBox x:Name="PasteHintBox"/>
              <TextBlock Text="{DynamicResource Disc.HintPlaceholder}" Style="{StaticResource BoxPlaceholder}"
                         Tag="{Binding Text, ElementName=PasteHintBox}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="{DynamicResource Disc.Distill}" Style="{StaticResource PrimaryButton}" Margin="0,2,8,2"
                      Click="DistillText_Click"/>
              <TextBlock Text="{DynamicResource Disc.DistillCost}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                         TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="640"/>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="PasteBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
